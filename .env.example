# Porta HTTP (Render injeta PORT automaticamente)
PORT=3000

# Caminho do arquivo SQLite. Em produção aponte para o disco persistente.
DATABASE_PATH=./data/sales.db

# Segredo compartilhado para autenticar os postbacks.
# Se definido, todo POST /webhooks/sales precisa enviar o header
#   x-webhook-secret: <este valor>
# Se vazio/ausente, a verificação é desativada (útil para testes locais).
WEBHOOK_SECRET=
